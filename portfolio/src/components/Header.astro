---
import { nav, site } from '../lib/site';
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class="fixed inset-x-0 top-3 z-40 px-3 sm:px-6">
  <div class="glass mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 !rounded-3xl px-5 py-3 sm:!rounded-full">
    <a href="/" class="font-semibold tracking-tight">{site.name}</a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm sm:gap-x-6">
        {nav.map((i) => (
          <li>
            <a href={i.href} aria-current={path === i.href ? 'page' : undefined}
               class:list={['muted transition-colors hover:!text-[var(--fg)]', { '!text-[var(--fg)] font-medium': path === i.href }]}>
              {i.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
