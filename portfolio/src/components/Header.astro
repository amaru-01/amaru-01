---
import { nav, site } from '../lib/site';
const path = Astro.url.pathname.replace(/\/$/, '');
---
<header class="fixed inset-x-0 top-3 z-40 px-3 sm:px-6">
  <div class="glass mx-auto max-w-6xl !rounded-3xl px-4 py-2.5 sm:!rounded-full sm:px-5 sm:py-3" id="site-header">
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="py-1.5 font-semibold tracking-tight">{site.name}</a>

      <!-- Desktop / no-JS: inline links -->
      <nav aria-label="Main" class="nav-inline hidden sm:block">
        <ul class="flex items-center gap-6 text-sm">
          {nav.map((i) => (
            <li>
              <a href={i.href} aria-current={path === i.href ? 'page' : undefined}
                 class:list={['muted transition-colors hover:!text-[var(--fg)]', { '!text-[var(--fg)] font-medium': path === i.href }]}>
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile toggle (shown only when JS is available) -->
      <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu"
              class="menu-toggle btn-glass hidden h-11 w-11 items-center justify-center rounded-full sm:!hidden" aria-label="Open menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="bar-top" d="M4 8h16" /><path class="bar-mid" d="M4 12h16" /><path class="bar-bot" d="M4 16h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu panel -->
    <nav id="mobile-menu" aria-label="Main" class="mobile-menu sm:hidden" hidden>
      <ul class="mt-2 border-t border-[var(--glass-border)] pt-2 text-lg">
        {nav.map((i) => (
          <li>
            <a href={i.href} aria-current={path === i.href ? 'page' : undefined}
               class:list={['flex min-h-12 items-center justify-between rounded-2xl px-3', { 'font-semibold text-[var(--color-accent)]': path === i.href }]}>
              {i.label}<span aria-hidden="true" class="muted">›</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- No-JS fallback on mobile: show links inline under the brand -->
  <noscript>
    <style>.nav-inline{display:block!important}.nav-inline ul{flex-wrap:wrap;gap:.25rem 1rem}</style>
  </noscript>
</header>

<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const header = document.getElementById('site-header');
  if (btn && menu && header) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn.focus(); } });
    document.addEventListener('click', (e) => { if (!header.contains(e.target as Node)) set(false); });
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    window.matchMedia('(min-width: 640px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  }
</script>

<style is:global>
  /* Button only appears when JS runs (class added in <head>), and only below the sm breakpoint. */
  .js .menu-toggle { display: inline-flex; }
  @media (min-width: 640px) { .js .menu-toggle { display: none; } }
  /* On mobile with JS, links live in the dropdown, so hide the inline copy; without JS the noscript style shows it. */
  @media (max-width: 639px) { .nav-inline { display: none; } }
</style>
