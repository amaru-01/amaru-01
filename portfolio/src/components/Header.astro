---
import { nav, site } from '../lib/site';
import { hasDesignWork } from '../lib/sanity';

const path = Astro.url.pathname.replace(/\/$/, '');
const showDesign = await hasDesignWork();
const links = nav.filter((i) => i.href !== '/design' || showDesign);
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header wrap" id="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true">
        <circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="1" />
        <path d="M6 13 Q17 19 27 37" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
      <span class="display">{site.nickname}</span>
      <span class="label sub">Paul Kimaru, Nairobi</span>
    </a>

    <nav aria-label="Main" class="nav-inline">
      <ul>
        {links.map((i) => (
          <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </nav>

    <button type="button" id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <path d="M4 9 Q12 6 20 9" /><path d="M4 15 Q12 12 20 15" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="mobile-menu" hidden>
    <ul>
      {links.map((i) => (
        <li><a href={i.href} aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a></li>
      ))}
    </ul>
  </nav>

  <noscript><style>.nav-inline{display:block!important}.nav-inline ul{flex-wrap:wrap}</style></noscript>
</header>

<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const header = document.getElementById('site-header');
  if (btn && menu && header) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    document.addEventListener('click', (e) => { if (!header.contains(e.target as Node)) set(false); });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  }
</script>

<style>
  .site-header { padding-top: 1.5rem; position: relative; z-index: 20; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .brand { display: flex; align-items: center; gap: .75rem; text-decoration: none; }
  .brand .display { font-size: 2rem; line-height: 1; }
  .brand .sub { margin-left: .75rem; display: none; }
  @media (min-width: 1024px) { .brand .sub { display: inline; } }

  .nav-inline ul { display: flex; gap: 2.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-inline a, .mobile-menu a {
    font-family: var(--font-display); font-style: italic; font-size: 1.05rem;
    text-decoration: none; color: var(--graphite); transition: color .2s;
  }
  .nav-inline a:hover, .mobile-menu a:hover { color: var(--ink); }
  .nav-inline a[aria-current='page'], .mobile-menu a[aria-current='page'] {
    color: var(--ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .35em;
  }

  .menu-toggle {
    display: none; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center;
    border-radius: 50%; border: 1px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer;
  }
  .mobile-menu ul { list-style: none; margin: 1rem 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .mobile-menu li { border-bottom: 1px solid var(--rule-soft); }
  .mobile-menu a { display: flex; min-height: 3.25rem; align-items: center; font-size: 1.5rem; color: var(--ink); }

  @media (max-width: 767px) {
    .nav-inline { display: none; }
    :global(.js) .menu-toggle { display: inline-flex; }
  }
  @media (min-width: 768px) { .mobile-menu { display: none; } }
</style>
