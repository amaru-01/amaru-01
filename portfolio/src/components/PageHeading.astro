---
interface Props { title: string; lead?: string; }
const { title, lead } = Astro.props;
---
<div class="page-heading">
  <h1 class="display">{title}</h1>
  {lead && <p class="lead graphite">{lead}</p>}
  <svg class="arc" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path class="crease-draw" pathLength="1" d="M0 110 C300 110 700 90 1200 4" fill="none" style="stroke:var(--rule)" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<style>
  .page-heading { padding-top: 4.5rem; margin-bottom: 3.5rem; }
  h1 { font-size: clamp(3.25rem, 9vw, 7rem); }
  .lead { margin-top: 1.5rem; font-size: 1.3rem; line-height: 1.45; max-width: 44ch; }
  .arc { width: 100%; height: 72px; display: block; margin-top: 2rem; }
</style>
