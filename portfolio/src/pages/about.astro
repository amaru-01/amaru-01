---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import { site } from '../lib/site';
---
<Base title="About" description="About Paul Kimaru (Amaru), a software engineer, designer and photographer in Nairobi.">
  <div class="wrap">
    <PageHeading title="Hi, I'm Paul." lead="Mwangi Paul Kimaru, known online as Amaru. Based in Nairobi, Kenya." />
    <div class="cols">
      <div class="measure prose">
        <p>I graduated from the University of Nairobi with a degree in Computer Science. Most of my work is full-stack web and mobile development, with AI integration, data analytics and visual media mixed in. I've built Flutter and Laravel apps, deployed Node.js and PostgreSQL platforms to VPS servers, and built AI chatbots with Botpress and Dialogflow.</p>
        <p>Before and alongside code, I've worked as a graphic designer, and I photograph as T.C.O.A Photography. I like building things that are useful and look good.</p>
      </div>
      <dl class="facts">
        <div><dt class="label">Builds with</dt><dd>Next.js, Laravel, Node.js, Flutter, PostgreSQL</dd></div>
        <div><dt class="label">AI</dt><dd>Botpress, Dialogflow, OpenCV, MediaPipe</dd></div>
        <div><dt class="label">Visual</dt><dd>Graphic design, 3D, photography</dd></div>
        <div><dt class="label">Elsewhere</dt><dd><a class="link" href={site.github} rel="noopener">GitHub</a> · <a class="link" href={site.linkedin} rel="noopener">LinkedIn</a></dd></div>
      </dl>
    </div>
    <p class="close"><a class="arch arch-primary" href="/contact">Get in touch</a>{site.cvUrl && <a class="arch arch-secondary" href={site.cvUrl}>Download CV</a>}</p>
  </div>
</Base>

<style>
  .cols { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .cols { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 5rem; } }
  .prose p { font-size: 1.25rem; line-height: 1.6; }
  .prose p + p { margin-top: 1.25rem; }
  .facts { margin: 0; display: grid; gap: 1.25rem; align-content: start; }
  .facts > div { border-top: 1px solid var(--rule-soft); padding-top: .75rem; }
  .facts dd { margin: .2rem 0 0; }
  .close { margin-top: 4rem; display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
