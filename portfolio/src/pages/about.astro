---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
---
<Base title="About" description="About me.">
  <PageHeading eyebrow="About" title="Hi, I'm Paul." lead="Mwangi Paul Kimaru, known online as Amaru. Based in Nairobi, Kenya." />
  <div class="glass max-w-3xl p-8 text-lg leading-relaxed">
    <p>I'm a computing graduate of the University of Nairobi who works across full-stack web and mobile development, AI integration, data analytics and visual media. I've built Flutter and Laravel applications, deployed Node.js and PostgreSQL platforms on VPS servers, and engineered AI chatbots with Botpress and Dialogflow.</p>
    <p class="mt-4">Before and alongside code, I've worked as a graphic designer, and I photograph as T.C.O.A Photography. I like building things that are useful and look good.</p>
  </div>
</Base>
