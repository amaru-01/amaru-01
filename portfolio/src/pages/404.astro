---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="glass mx-auto max-w-xl p-10 text-center">
    <p class="muted text-sm">404</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="muted mt-3">That page doesn't exist or has moved.</p>
    <a href="/" class="btn btn-primary mt-6">Back home</a>
  </section>
</Base>
