---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { site } from '../lib/site';
---
<Base title="Contact" description="Get in touch with Paul Kimaru.">
  <div class="wrap">
    <PageHeading title="Let's talk." lead="Open to full-time roles, contract work and collaborations. Email is the fastest way to reach me." />
    <a class="display email" href={`mailto:${site.email}`}>{site.email}</a>
    <dl class="list">
      <div><dt class="label">GitHub</dt><dd><a class="link with-icon" href={site.github} rel="noopener"><SocialIcon name="github" size={18} />{site.github.replace('https://', '')}</a></dd></div>
      <div><dt class="label">LinkedIn</dt><dd><a class="link with-icon" href={site.linkedin} rel="noopener"><SocialIcon name="linkedin" size={18} />{site.linkedin.replace('https://www.', '')}</a></dd></div>
      <div><dt class="label">Photography</dt><dd><a class="link" href={site.photographyUrl} rel="noopener">{site.photographyUrl.replace('https://', '')}</a></dd></div>
      {site.cvUrl && <div><dt class="label">CV</dt><dd><a class="link" href={site.cvUrl}>Download (PDF)</a></dd></div>}
    </dl>
  </div>
</Base>

<style>
  .email { display: inline-block; font-size: clamp(1.9rem, 6vw, 4.5rem); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .15em; text-decoration-color: var(--shade-mid); overflow-wrap: anywhere; }
  .email:hover { text-decoration-color: var(--ink); }
  .list { margin: 3.5rem 0 0; max-width: 44rem; }
  .list > div { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--rule-soft); }
  .list > div:last-child { border-bottom: 1px solid var(--rule-soft); }
  .list dd { margin: 0; overflow-wrap: anywhere; }
  .with-icon { display: inline-flex; align-items: center; gap: .6rem; }
  .with-icon :global(svg) { flex: none; color: var(--graphite); }
</style>
