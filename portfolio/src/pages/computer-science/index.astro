---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import { site } from '../../lib/site';
import { getProjectsByCategory } from '../../lib/sanity';
import { getCodeProjects } from '../../lib/code-projects';

// README featured projects lead, then the other case studies; CMS code projects follow.
const projects = await getCodeProjects();
const cmsProjects = await getProjectsByCategory('cs');
---
<Base title="Code" description="Software projects by Paul Kimaru: what each one solves, his role and the stack.">
  <div class="wrap">
    <PageHeading title="Code" lead="Software I've designed and built: what each project solves, my part in it, and what it runs on." />

    {projects.length + cmsProjects.length === 0 ? (
      <p class="measure">Projects are being written up. In the meantime, the code is on <a class="link" href={site.github}>GitHub</a>.</p>
    ) : (
      <ol class="plates">
        {projects.map((p, i) => {
          const cs = p.caseStudy?.entry;
          const href = cs ? `/computer-science/${cs.id}` : undefined;
          const status = cs?.data.status;
          return (
            <li class="plate">
              <span class="no plate-no">Pl. {i + 1}</span>
              <div class="body">
                <h2 class="display title">
                  {href ? <a href={href}>{p.title}</a>
                    : p.demo ? <a href={p.demo} target="_blank" rel="noopener noreferrer">{p.title}<span class="sr-only"> (opens in a new tab)</span></a>
                    : p.title}
                </h2>
                <p class="summary">{p.summary}</p>
                {p.tech.length > 0 && <p class="stack graphite">{p.tech.join(' · ')}</p>}
              </div>
              <div class="side">
                {status && <p class="label status">{status === 'live' ? 'Live' : status === 'prototype' ? 'Prototype' : 'In development'}</p>}
                <ul class="links">
                  {href && <li><a class="link" href={href}>Case notes</a></li>}
                  {p.demo && <li><a class="link" href={p.demo} target="_blank" rel="noopener noreferrer">Live demo<span class="sr-only"> (opens in a new tab)</span></a></li>}
                </ul>
              </div>
              {href && cs?.data.cover && (
                <a class="shot" href={href} tabindex="-1" aria-hidden="true">
                  <Image src={cs.data.cover} alt="" widths={[640, 1100, 1600]} sizes="(min-width: 1024px) 60vw, 100vw" />
                </a>
              )}
            </li>
          );
        })}
        {cmsProjects.map((p, i) => (
          <li class="plate">
            <span class="no plate-no">Pl. {projects.length + i + 1}</span>
            <div class="body">
              <h2 class="display title">{p.demoUrl ? <a href={p.demoUrl} target="_blank" rel="noopener noreferrer">{p.title}<span class="sr-only"> (opens in a new tab)</span></a> : p.title}</h2>
              {p.summary && <p class="summary">{p.summary}</p>}
              {(p.tools?.length ?? 0) > 0 && <p class="stack graphite">{p.tools!.join(' · ')}</p>}
            </div>
            <div class="side">
              {p.client && <p class="label status">{p.client}</p>}
              <ul class="links">
                {p.demoUrl && <li><a class="link" href={p.demoUrl} target="_blank" rel="noopener noreferrer">Visit {p.title}<span class="sr-only"> (opens in a new tab)</span></a></li>}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>

<style>
  .plates { list-style: none; margin: 0; padding: 0; }
  .plate { display: grid; gap: .5rem 2rem; padding: 1.75rem 0 2.25rem; }
  .plate:last-child { border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) {
    .plate { grid-template-columns: 5rem minmax(0, 1fr) 13rem; }
    .shot { grid-column: 2 / 3; }
  }
  .no { font-size: 1.5rem; line-height: 1.4; }
  .title { font-size: clamp(2.1rem, 4vw, 3.25rem); line-height: 1; }
  .title a { text-decoration: none; }
  .title a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .12em; }
  .summary { margin-top: .9rem; font-size: 1.2rem; max-width: 52ch; }
  .stack { margin-top: .6rem; font-size: 1rem; }
  .side { padding-top: .5rem; }
  .status { margin-bottom: .5rem; color: var(--ink); }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .3rem; font-size: 1rem; }
  @media (max-width: 899px) { .links { flex-direction: row; flex-wrap: wrap; gap: .3rem 1.25rem; } }
  .shot { display: block; margin-top: 1.25rem; }
  .shot :global(img) { width: 100%; height: auto; display: block; }
</style>
