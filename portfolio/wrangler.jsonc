{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static Astro site served as Workers static assets: no Worker code, no adapter.
  "name": "paul-kimaru-portfolio",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  },
  // Enables `wrangler preview`, which Workers Builds runs for non-production
  // branches (PR preview links). Empty is enough: assets stay top-level.
  "previews": {}
}
